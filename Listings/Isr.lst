  46          //=============================================================================
  47          //定时器3，中断处理函数
  48          void TM3_INT(void)      interrupt       7
  49          {
  50   1              b2HzFlag = 1;
  51   1              INTFLG &= ~TF3;                                                 //清TM3中断标志
  52   1      }
