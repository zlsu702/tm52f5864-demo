  12          //定时器0，中断处理函数 //256hz
  13          void TM0_INT(void)      interrupt       1
  14          {       
  15   1              //重要：必须靠前
  16   1              TH0=D_TM0H;                                                             
  17   1              TL0=D_TM0L;                                                     //手动重载
  18   1              
  19   1              Freq128Hz++;
  20   1              if(Freq128Hz>7)
  21   1              {
  22   2                      Freq128Hz = 0;
  23   2                      b32HzFlag = 1;
  24   2              }       
  25   1                      
  26   1              
  27   1              TF0=0;                                                          //TM0中断标志清零       
  28   1      }
  29          //=============================================================================
  30          //定时器1，中断处理函数 //8k    
  31          void TM1_INT(void)      interrupt       3
  32          {                                                       
  33   1              TH1=D_TM1H;
  34   1              TL1=D_TM1L;
  35   1              
  36   1              CheckReceiveData();
  37   1              
  38   1              TF1=0;                                                                  //TM1中断标志清零                                                                                       
  39   1      }
