 325          static uchar CRC_8(uchar numh,uchar numl) 
 326          {
 327   1              uchar i;
 328   1              uchar crc8 = 0xff;
 329   1              crc8 ^= numh;
 330   1              for (i = 8; i > 0; --i)
 331   1              {
 332   2                      if ((crc8 & 0x80) != 0)
 333   2                      {
 334   3                              crc8 *= 2;
 335   3                              crc8 ^= 0x31;
 336   3                      }
 337   2                      else
 338   2                      {
 339   3                              crc8 *= 2;
 340   3                      }
 341   2              }
 342   1      
 343   1              crc8 ^= numl;
 344   1              for (i = 8; i > 0; --i)
 345   1              {
 346   2                      if ((crc8 & 0x80) != 0)
 347   2                      {
 348   3                      crc8 *= 2;
 349   3                      crc8 ^= 0x31;
 350   3                      }
 351   2                      else
 352   2                      {
 353   3                      crc8 *= 2;
 354   3                      }
 355   2              }
 356   1              return crc8;
 357   1      }
