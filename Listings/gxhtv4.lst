 109          static uchar I2CWriteByte(uchar wdata)
 110          {
 111   1              uchar i;
 112   1              uchar err = 1;
 113   1              for(i=0;i<8;i++)
 114   1              {
 115   2                      SetSCLK_LOW;
 116   2                      I2CDelay();
C51 COMPILER V9.00   GXHTV4                                                                01/25/2026 17:20:40 PAGE 3   

 117   2                      if(wdata&0x80)
 118   2                              SetSDIO_HIGH;
 119   2                      else
 120   2                              SetSDIO_LOW;    
 121   2                      I2CDelay();      
 122   2                      SetSCLK_HIGH;
 123   2                      I2CDelay();
 124   2                      wdata <<=1;
 125   2              }
 126   1              //I2CWaitAck
 127   1              SetSCLK_LOW;    
 128   1              I2CDelay();
 129   1              SetSDIO_HIGH;
 130   1              I2CDelay();
 131   1              I2CDelay();
 132   1              SetSCLK_HIGH;
 133   1              for(i=0;i<4;i++)
 134   1              {
 135   2                      if(IO_SDA==0)
 136   2                      {
 137   3                              err = 0;
 138   3                              break;
 139   3                      }       
 140   2                      DelayNOP(50);   
 141   2              }
 142   1              SetSCLK_LOW;    
 143   1              return(err);
 144   1      }
 145          
 146          static uchar I2CReadByte(void)
 147          {
 148   1              uchar i;
 149   1              uchar rdata;
 150   1              
 151   1              SetSDIO_HIGH;
 152   1              for(i=0;i<8;i++)
 153   1              {
 154   2                      I2CDelay();
 155   2                      SetSCLK_LOW;
 156   2                      I2CDelay();
 157   2                      rdata <<=1;
 158   2                      SetSCLK_HIGH;
 159   2                      I2CDelay();
 160   2                      if(IO_SDA)              
 161   2                              rdata |= 0x01;  
 162   2              }
 163   1              return(rdata);
 164   1      }
