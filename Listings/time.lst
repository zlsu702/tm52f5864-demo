 230          static uchar GetMonthMaxDate(void)
 231          {
 232   1              uchar max_day;
 233   1              uchar max_month;
 234   1              if(Month==2)
 235   1              {
 236   2                      if(Year&0x03)
 237   2                              max_day = 28;
 238   2                      else
 239   2                              max_day = 29;           
 240   2              }       
 241   1              else
 242   1              {
 243   2                      if(Month<8)
 244   2                              max_month = Month;
 245   2                      else    
 246   2                              max_month = Month-1;
 247   2                      if(max_month&0x01)
 248   2                              max_day = 31;   
 249   2                      else
 250   2                              max_day = 30;   
 251   2              }       
 252   1              return(max_day);
 253   1      }
