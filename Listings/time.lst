 256          ;;      6/2/2/5/0/3/5/1/4/6/2/4                 
 257          ;功能: 根据阳历日期自动校正星期
 258          ;入口参数:  RealYear[1:0]为16进制数年份
 259          ;          RealMonth为16进制月份
 260          ;          RealDate[1:0]为16进制数日期
 261          ;出口参数: RealWeek为校正后的星期
 262          ;影响寄存器: R[3:0]
 263          ;计算方法: RealWeek=(闰年个数+校正日期+日期+年)%7
 264          */
 265          void AdjustWeek(void)
 266          {
 267   1              uchar day_sum;
 268   1              
 269   1              day_sum = WeekAdjustTab[Month];
 270   1              
 271   1              day_sum = day_sum+Year+Year/4+Day+1;
 272   1              if(((Year&0x03)==0)&&(Month<3))
 273   1                      day_sum--;
 274   1              
 275   1              Week = day_sum%7;
 276   1      }
