 594          // p = v * (1 - s) = 0
 595          // q = v * (1 - s * fractional)
 596          // t = v * (1 - s * (1 - fractional))
 597          static void TurnLedRam(ulong *led_buff,uint *led_rgb)
 598          {
 599   1              uchar i,j,k;
 600   1              uchar redata;
 601   1              
 602   1              for(i=0;i<18;i++)
 603   1              {
 604   2                      if((((*led_buff)&Map_Bit[i])==0)||(DispLevel1==0))
 605   2                      {
 606   3                              Led_Ram[i][0] = 0;
 607   3                              Led_Ram[i][1] = 0;
 608   3                              Led_Ram[i][2] = 0;
 609   3                      }
C51 COMPILER V9.00   LED                                                                   01/25/2026 17:20:40 PAGE 11  

 610   2                      else
 611   2                      {       
 612   3                              j = (uchar)(*led_rgb/60);
 613   3                              k = (uchar)(*led_rgb%60);
 614   3                              redata = DispLevel1;    //v
 615   3                              switch(j)
 616   3                              {
 617   4                                      case 0:         // r, g, b = v, t, p
