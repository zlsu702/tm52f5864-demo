  57   1              CLKPSC_H = 1;           //SYSCLK Prescaler, 0:div16, 1:div4, 2:div2, 3:div1
  58   1              CLKPSC_L = 1;
  59   1              //分频后至少延时8个NOP  
  60   1              _nop_();        
