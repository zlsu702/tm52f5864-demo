 293          //功能：定时器0初始化，定时模式，优先级为1
 294          //输入参数：无
 295          //输出参数：无
 296          //备注：
 297          //=============================================================================
 298          void TM0_Init(void)
 299          {               
 300   1              ET0= 0;                 //TM0中断禁止   
 301   1              TR0= 0;                 //TM0停止
 302   1      
C51 COMPILER V9.00   SYSINIT                                                               01/25/2026 17:20:41 PAGE 6   

 303   1              //屏蔽TM0门控信号
 304   1              TMOD &= ~GATE0;
 305   1              //计时模式（重要）      
 306   1              TMOD &= ~CT0;
 307   1              //TM0以方式1工作,16位计时/计数器
 308   1              TMOD = (TMOD & T0_Mask) | T0_Mode1;
 309   1              
 310   1              //定时时间
 311   1              TH0 = D_TM0H;                                                           
 312   1              TL0 = D_TM0L;                                                                                                                   
 313   1              
 314   1              //TM0 中断优先级为0
 315   1              IP &= ~PT0;                                                                     
 316   1              IPH &= ~IPH_PT0H;                                                                                                       
 317   1                                                                                                                                      
 318   1              ET0 = 1;                                                                //TM0中断使能
 319   1              TF0 = 0;                                                                //TM0中断标志清零
 320   1              TR0 = 1;                                                                //TM0开启
 321   1      }
