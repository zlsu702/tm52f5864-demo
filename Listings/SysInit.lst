 553          //=============================================================================
 554          //功能：ADC初始化
 555          //输入参数：无
 556          //输出参数：无
 557          //备注：
 558          //=============================================================================
 559          
 560          void ADC_Init(void)
 561          {
 562   1              //ADC Clock Rate:SysClk/8
 563   1              OPTION = (OPTION & ADCKS_Mask)|ADCKS_sys_16;
 564   1              ADCVERFS_VCC;           //VCC
 565   1      //      ADCHSEL = ADCVERFS|VBG_01;              //VBG 2.0v
 566   1              //清ADC中断标志位       
 567   1              INTFLG = ~ADIF;                                         
 568   1      }
 569          
 570          u16 ADC_Convert( uchar Adc_ch )
 571          {
 572   1              static u16 adcNum;
 573   1              uchar adcNumH;
 574   1              uchar adcNumL;
 575   1              ADCHSEL = (ADCHSEL & ~0xf8)|Adc_ch;
 576   1              ADSOC = 1;
 577   1              while(ADSOC==1);
 578   1              
 579   1              adcNumL = ADCDL&0xF0;
 580   1              adcNumH = ADCDH;
 581   1              
 582   1              adcNum = adcNumH*256 + adcNumL;
 583   1              adcNum = (adcNum>>4)&0x0fff;
 584   1              return(adcNum);
 585   1      } 
 586          
 587          u8 ADC_Convert1( uchar Adc_ch )
 588          {
 589   1              uchar adcNum;
 590   1              ADCHSEL = (ADCHSEL & ~0xf8)|Adc_ch;
 591   1              ADSOC = 1;
 592   1              while(ADSOC==1);
 593   1              
 594   1              adcNum = ADCDH;
 595   1              
 596   1              return(adcNum);
 597   1      } 
