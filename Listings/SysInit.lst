  20          //=============================================================================
  21          //功能：初始化需要使用的功能模块
  22          //输入参数：无
  23          //输出参数：无
  24          //备注：        上电默认 Fsys = SRC，切换为 Fsys = FRC = 16.5888MHz/2 = 8.2944MHz
  25          //=============================================================================
  26          void InitDevice(void)
  27          {
  28   1              EA=0;                                           //关闭总中断开关
  29   1              OPTION = WDTPSC_02;                             //看门狗定时132ms
  30   1              AUX2  = 0;
  31   1              AUX1  = 0;
  32   1              WDT_RUN_FAST_DIS_ILDE;                          //看门狗开
  33   1              PDOWN_LVD_DISABLE;
  34   1              LVRCON = LVRSEL_0011;                   //LVR = 2.3V
  35   1              SysClk_Init();
  36   1              IO_Init();      
  37   1              ADC_Init();
  38   1              TM0_Init();
  39   1              TM1_Init();
  40   1              TM3_Init();
  41   1              PWM_Init();
  42   1              EA=1;                                           //开启总中断开关
  43   1      }
  44          //=============================================================================
