 333   1              TH0=D_TM0H;                                                             
 334   1              TL0=D_TM0L;                                                             //TM0开启
 335   1              ET0 = 1;                                                                //TM0中断使能
 336   1              TF0 = 0;                                                                //TM0中断标志清零
 337   1              TR0 = 1;        
 338   1      }
