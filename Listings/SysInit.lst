 504          //=============================================================================
 505          //功能：定时器3初始化，中断优先级0
 506          //输入参数：无
 507          //输出参数：无
 508          //备注：
 509          //=============================================================================
 510          
 511          void TM3_Init(void)
 512          {
 513   1              CLRTM3 = 1;                                                     //清除TM3
 514   1              OPTION &= ~TM3CKS;
 515   1              TM3RLD = (((unsigned long)0x10000-16384)>>8)&0xFF;              //溢出周期=500ms
 516   1              INTFLG &= ~TF3;                                                 //清TM3中断标志
 517   1              IP1 &= ~PT3;
 518   1              IP1H &= ~PT3H;                                                  //TM3中断优先级0
 519   1              INTE1 |= TM3IE;                                                 //TM3中断使能
 520   1              CLRTM3 = 0;                                                     //开启TM3
 521   1      }
