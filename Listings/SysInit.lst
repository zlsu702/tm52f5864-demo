 604          //=============================================================================
 605          
 606          void PWM_Init(void)
 607          {
 608   1              CLRPWM0 = 1;                            //PWM0关闭
 609   1              CLRPWM1 = 1;                            //PWM0关闭
 610   1              PWMCON = 0x00;                          //PWM FSYSCLK
 611   1              PWMCON2 = 0x00;                         //正常模式
 612   1              PWM0PRDL = 0xca;                        //PWM0周期
C51 COMPILER V9.00   SYSINIT                                                               01/25/2026 17:20:41 PAGE 11  

 613   1              PWM0PRDH = 0x08;                        //PWM0周期
 614   1              PWM1PRD = 0xff;                         //PWM1周期 2k
 615   1              AUX3 = (AUX3&~0xe0)|0xA0;               //PWM1~6频率分频/32
 616   1              
 617   1              PWM0DL = 0x00;                          //PWM0占空比
 618   1              PWM0DH = 0x00;
 619   1              PWM1D = 0;                              //PWM1占空比
 620   1              PWM2D = 0;
 621   1              PWM3D = 0;
 622   1              PWM4D = 0;
 623   1              PWM5D = 0;
 624   1              PWM6D = 0;
 625   1      }
 626          
 627          void PWM_ALL_Off(void)
 628          {
 629   1              CLRPWM1 = 1;    
 630   1              PWMCON &= ~PWM1EN;
 631   1              P0MOD76 = (P0MOD76&~0x0f)|2<<0;
 632   1              P0_6 = 0;
 633   1              P2MOD10 = (P2MOD10&~0x0f)|2<<0;
 634   1              P2_0 = 0;
 635   1      }
 636          
 637          
 638          void PWM_On(void)
 639          {
 640   1              uchar tmp_duty;
 641   1              tmp_duty =9*DispLevel/10;
 642   1              if(DispLevel)
 643   1              {
 644   2                      PWM1D = 255-tmp_duty;   
 645   2                      P0MOD76 = (P0MOD76&~0x0f)|11<<0;
 646   2              }       
 647   1              else
 648   1              {
 649   2                      P0MOD76 = (P0MOD76&~0x0f)|2<<0;
 650   2                      P0_6 = 1;
 651   2              }       
 652   1              CLRPWM1 = 0;    
 653   1              PWMCON |= PWM1EN;
 654   1      }               
 655          
 656          void PWM_Off(void)
 657          {
 658   1              P0MOD76 = (P0MOD76&~0x0f)|2<<0;
 659   1              P0_6 = 0;
 660   1      }       
